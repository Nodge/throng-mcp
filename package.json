{
    "name": "throng-mcp",
    "version": "0.1.0",
    "description": "MCP server that delegates coding tasks to Claude Code, Codex and OpenCode over ACP",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Nodge/throng-mcp.git"
    },
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=24"
    },
    "packageManager": "pnpm@11.10.0",
    "scripts": {
        "start": "node src/mcp.ts",
        "typecheck": "tsc --noEmit",
        "test": "vitest --run",
        "test:watch": "vitest",
        "lint": "eslint .",
        "fmt": "prettier --write . --log-level error",
        "ci:lint": "eslint .",
        "ci:fmt": "prettier --check .",
        "ci:typecheck": "tsc --noEmit",
        "ci:tests": "vitest --run",
        "smoke": "node scripts/smoke/smoke.ts",
        "smoke:claude": "node scripts/smoke/smoke.ts claude/sonnet",
        "smoke:claude-schema": "node scripts/smoke/smoke.ts claude/sonnet --schema",
        "smoke:codex": "node scripts/smoke/smoke.ts codex/gpt-6-luna",
        "smoke:codex-schema": "node scripts/smoke/smoke.ts codex/gpt-6-luna --schema",
        "smoke:opencode": "node scripts/smoke/smoke.ts opencode/openrouter/z-ai/glm-5.3-flash",
        "smoke:opencode-schema": "node scripts/smoke/smoke.ts opencode/openrouter/z-ai/glm-5.3-flash --schema"
    },
    "dependencies": {
        "@agentclientprotocol/sdk": "^1.5.0",
        "@modelcontextprotocol/sdk": "^1.30.1",
        "ajv": "^8.20.0",
        "yaml": "^2.9.1",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^24.19.0",
        "eslint": "^10.11.0",
        "lefthook": "^2.1.15",
        "prettier": "^3.9.9",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.71.0",
        "vitest": "^5.0.3"
    }
}
